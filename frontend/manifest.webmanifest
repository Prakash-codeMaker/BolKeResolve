{
  "id": "/",
  "name": "BolKeResolve — Resolution Passport",
  "short_name": "BolKeResolve",
  "description": "Organise your consumer or payment issue, evidence, next steps and follow-up in one portable case record.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f8f5ee",
  "theme_color": "#083e37",
  "orientation": "any",
  "icons": [
    {
      "src": "/assets/bolkeresolve-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/bolkeresolve-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "shared_file",
          "accept": [
            ".png",
            ".jpg",
            ".jpeg",
            ".webp",
            ".pdf"
          ]
        }
      ]
    }
  }
}
