# Local development defaults. Do not expose this server publicly in development mode.
# Accounts are enabled locally. Sign-in is required by default so saved cases/evidence
# are scoped to the account. Set BOLKE_AUTH_REQUIRED=false only for a guest demo with
# synthetic data; anonymous cases then share the local guest workspace.
BOLKE_ENV=development
BOLKE_AUTH_REQUIRED=true
BOLKE_ACCOUNTS_ENABLED=true
BOLKE_COOKIE_SECURE=false
BOLKE_DATA_DIR=./runtime
# Optional exact comma-separated browser origins for a stable Preview/staging host. No wildcards.
BOLKE_ALLOWED_ORIGINS=
BOLKE_PUBLIC_ORIGIN=
# In production, email verification is mandatory. Prefer Gmail Apps Script HTTPS bridge on Render Free when no custom domain is available.
BOLKE_EMAIL_VERIFICATION_REQUIRED=false
# Optional Resend API delivery (requires a verified sender domain).
RESEND_API_KEY=
# Gmail Apps Script bridge (no custom domain; see README for setup).
BOLKE_GMAIL_SCRIPT_URL=
BOLKE_GMAIL_SCRIPT_TOKEN=
# Gmail account owning the Apps Script bridge; also used as the sender display address.
BOLKE_EMAIL_FROM=
BOLKE_SMTP_HOST=
BOLKE_SMTP_PORT=587
BOLKE_SMTP_USERNAME=
BOLKE_SMTP_PASSWORD=
BOLKE_SMTP_FROM=
BOLKE_SMTP_USE_STARTTLS=true
BOLKE_SMTP_USE_SSL=false

# Gnani speech. Keep the key on the server; never add it to frontend files.
# Add a valid key from your Gnani account to enable live speech and spoken guidance.
GNANI_API_KEY=
# Automatic language identification (indic-auto) requires Prisma v3.0.
# The server enforces v3.0 for auto mode; pinned language mode may use your configured model.
GNANI_STT_MODEL=prisma-v3.0
BOLKE_STT_LIMIT_PER_MINUTE=8
BOLKE_TTS_LIMIT_PER_MINUTE=20
BOLKE_LIVE_STT_LIMIT_PER_MINUTE=5
BOLKE_PUBLIC_VOICE_ENABLED=false

# Operator configuration required before a public deployment.
BOLKE_PRIVACY_POLICY_URL=
BOLKE_SUPPORT_EMAIL=
BOLKE_SUPPORT_URL=

# Optional messaging integrations. Leave blank unless you have configured the provider.
BOLKE_WHATSAPP_PROVIDER=meta
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_ENCRYPTION_KEY=
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_REMINDER_TEMPLATE_NAME=
WHATSAPP_REMINDER_TEMPLATE_LANGUAGE=en

# Optional Twilio WhatsApp Sandbox development adapter.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WEBHOOK_PUBLIC_URL=
TWILIO_STATUS_CALLBACK_URL=

# Optional vision analysis + same-language explanation. Case text is translated only
# when the user opts in at session start; an image is sent only after a separate
# per-image consent action. Keys remain server-side.
OPENAI_API_KEY=
BOLKE_MULTIMODAL_MODEL=gpt-6-astra
BOLKE_RESPONSES_API_URL=https://api.openai.com/v1/responses
BOLKE_LIVE_VISION_LIMIT_PER_MINUTE=8

# Timbre v3.0 offers a universal ten-language voice catalog. Keep v2.5 as the
# compatibility default; set to timbre-v3.0 only after confirming account access.
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_V3_VOICE=Chetana

# Optional operator-only quality summary endpoint. Generate a long random token.
BOLKE_QUALITY_METRICS_TOKEN=
